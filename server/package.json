{
  "name": "brewmap-server",
  "version": "0.1.0",
  "private": true,
  "description": "REST API for BrewMap, a mobile-based cafe discovery and management system for cafes in Indang, Cavite",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",

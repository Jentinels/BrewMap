# Copy this file to .env and fill it in. .env is ignored by git.
PORT=4000
# MongoDB Atlas connection string (Database > Connect > Drivers), with the database name brewmap
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/brewmap?retryWrites=true&w=majority
# Any long random string, for example the output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES=7d
# Password for the demo accounts that `npm run seed` creates (admin@brewmap.test, owner@brewmap.test, user@brewmap.test). Development only.
SEED_PASSWORD=brewmap-demo-1234
